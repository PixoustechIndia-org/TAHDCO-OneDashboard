# ============================================================================
# SonarQube analysis configuration - TAHDCO OneDashboard (UDP)
# ============================================================================
# DO NOT MOVE THIS FILE BACK TO THE REPOSITORY ROOT.
#
# The C# half of this repository can only be analysed by the SonarScanner for
# .NET (`dotnet sonarscanner begin` -> `dotnet build` -> `dotnet sonarscanner
# end`), because the C# rules run as Roslyn analysers during compilation.
#
# That scanner does not merely ignore a sonar-project.properties file at the
# project base directory - it ABORTS. Observed for real in workflow run
# 32763152844 with scanner 11.2.1:
#
#   sonar-project.properties files are not understood by the SonarScanner
#   for .NET. Remove those files from the following folders: <repo root>
#   Post-processing failed. Exit code: 1
#
# The analysis was built and the coverage reports were produced, but nothing
# was published. Hence this file lives under docs/ with a .reference suffix.
#
# THE LIVE CONFIGURATION IS THE `dotnet sonarscanner begin` COMMAND IN
# .github/workflows/deploy.yml. Every analysis-critical value below
# (exclusions, coverage report paths, encoding, projectBaseDir) is passed
# there explicitly, and the two must be kept in sync by hand.
#
# This file is documentation of the intended analysis scope, and is what a
# plain `sonar-scanner` CLI run would consume if one were ever used.
# ============================================================================

# --- Project identity --------------------------------------------------------
sonar.projectKey=TAHDCO-OneDashboard-ss
sonar.projectName=TAHDCO OneDashboard (Unified Dashboard Platform)

sonar.sourceEncoding=UTF-8
sonar.scm.provider=git

# --- Production sources ------------------------------------------------------
# backend      : ASP.NET Core 8 solution (API, BAL, DAL, Model, Utils, SqlRunner)
# frontend/src : Angular 16 application (TypeScript, HTML, SCSS)
# database     : MySQL schema / seed / migration scripts
sonar.sources=backend,frontend/src,database

# --- Test sources ------------------------------------------------------------
# backend/API.Tests : xUnit test project
# frontend/src      : Angular *.spec.ts files (same tree as sources, so the
#                     split is driven by sonar.test.inclusions below)
sonar.tests=backend/API.Tests,frontend/src
sonar.test.inclusions=backend/API.Tests/**/*.cs,frontend/src/**/*.spec.ts

# --- Exclusions --------------------------------------------------------------
# backend/API/wwwroot : COMMITTED Angular production build output (~4.2 MB of
#                       minified JS/CSS). Never analysed, never modified.
sonar.exclusions=\
  backend/API/wwwroot/**,\
  **/bin/**,\
  **/obj/**,\
  **/node_modules/**,\
  **/dist/**,\
  frontend/e2e/**,\
  **/*.min.js,\
  **/*.min.css,\
  **/coverage/**,\
  **/TestResults/**,\
  **/.angular/**,\
  .sonarqube/**,\
  artifacts/**

# --- Coverage exclusions -----------------------------------------------------
# Files that carry no meaningful unit-test coverage signal. Nothing here is
# excluded to inflate a coverage number: SQL scripts, Angular bootstrap and
# environment constants are not unit-testable code paths.
sonar.coverage.exclusions=\
  database/**,\
  frontend/src/main.ts,\
  frontend/src/environments/**,\
  frontend/e2e/**

# --- Coverage report import --------------------------------------------------
# Both paths are produced by .github/workflows/deploy.yml at CI time only.
# If the corresponding step fails, the report is simply absent and SonarQube
# reports 0 coverage for that language - no coverage is ever synthesised.
sonar.cs.opencover.reportsPaths=artifacts/coverage/backend/**/coverage.opencover.xml
sonar.cs.vstest.reportsPaths=artifacts/coverage/backend/*.trx
sonar.javascript.lcov.reportsPaths=frontend/coverage/lcov.info,frontend/coverage/tahdco-udp/lcov.info
