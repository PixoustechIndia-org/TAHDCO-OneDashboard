# ── Database ──────────────────────────────────────
DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=tahdco_udp;User=web_user;Password=CHANGE_ME;Allow User Variables=true;Pooling=true;Min Pool Size=10;Max Pool Size=150;Connection Timeout=30;

# ── JWT Authentication ────────────────────────────
JWT_SECRET_KEY=GENERATE-STRONG-64-CHAR-BASE64-SECRET-FROM-VAULT

# ── Email (SMTP) ──────────────────────────────────
EMAIL_USER=your_email@tahdco.in
EMAIL_PASSWORD=YOUR_VAULT_STORED_SMTP_PASSWORD
EMAIL_FROM=noreply@tahdco.in

# ── AI / Voice Services (Store in Secret Vault) ──
SARVAM_API_KEY=YOUR_VAULT_STORED_SARVAM_API_KEY
OPENAI_API_KEY=YOUR_VAULT_STORED_OPENAI_API_KEY
GEMINI_API_KEY=YOUR_VAULT_STORED_GEMINI_API_KEY

# ── CORS ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ── SSH Deploy ────────────────────────────────────
SSH_HOST=your-server-ip
SSH_USER=deploy
