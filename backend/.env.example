# ── Database ──────────────────────────────────────
DB_CONNECTION_STRING=Server=localhost;Port=3306;Database=tahdco_udp;User=web_user;Password=CHANGE_ME;Allow User Variables=true;Pooling=true;Min Pool Size=10;Max Pool Size=150;Connection Timeout=30;

# ── JWT ───────────────────────────────────────────
JWT_SECRET_KEY=CHANGE-ME-32+CHARS-SUPER-SECRET-SIGNING-KEY-2026!

# ── Email (SMTP) ──────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@tahdco.com

# ── CORS ──────────────────────────────────────────
CORS_ORIGIN=http://localhost:4200

# ── SSH Deploy ────────────────────────────────────
SSH_HOST=your-server-ip
SSH_USER=deploy
