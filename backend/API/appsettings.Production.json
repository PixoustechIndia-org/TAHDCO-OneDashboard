{
  "EmailConfig": {
    "SmtpServer": "smtp.gmail.com",
    "Port": 587,
    "SSL": true,
    "Email": "${EMAIL_USER}",
    "Password": "${EMAIL_PASSWORD}",
    "From": "${EMAIL_FROM}"
  },
  "ConnectionStrings": {
    "Default": "${DB_CONNECTION_STRING}"
  },
  "Jwt": {
    "Issuer": "TahdcoUdp",
    "Audience": "TahdcoUdpClient",
    "Key": "${JWT_SECRET_KEY}",
    "ExpiryMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": [ "${CORS_ORIGIN}" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": { "Microsoft": "Warning", "Hangfire": "Warning" }
    }
  }
}
